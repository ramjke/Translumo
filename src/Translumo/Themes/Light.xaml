<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignExtensions;component/Themes/MaterialDesignLightTheme.xaml" />
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/materialdesigncolor.cyan.accent.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="PrimaryHueLightBrush" Color="#fbffff" />
    <SolidColorBrush x:Key="PrimaryHueLightForegroundBrush" Color="{StaticResource Accent400Foreground}" />
    <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="#c7f7ff" />
    <SolidColorBrush x:Key="PrimaryHueMidForegroundBrush" Color="{StaticResource Accent400Foreground}" />
    <SolidColorBrush x:Key="PrimaryHueDarkBrush" Color="#95c4cc" />
    <SolidColorBrush x:Key="PrimaryHueDarkForegroundBrush" Color="{StaticResource Accent400Foreground}" />

    <SolidColorBrush x:Key="SecondaryHueLightBrush" Color="#fbffff" />
    <SolidColorBrush x:Key="SecondaryHueLightForegroundBrush" Color="{StaticResource Accent400Foreground}" />
    <SolidColorBrush x:Key="SecondaryHueMidBrush" Color="#c7ffea" />
    <SolidColorBrush x:Key="SecondaryHueMidForegroundBrush" Color="{StaticResource Accent400Foreground}" />
    <SolidColorBrush x:Key="SecondaryHueDarkBrush" Color="#95ccb8" />
    <SolidColorBrush x:Key="SecondaryHueDarkForegroundBrush" Color="{StaticResource Accent400Foreground}" />

    <SolidColorBrush x:Key="ErrorBrush" Color="#f03a16" />
    <SolidColorBrush x:Key="WarningBrush" Color="#ffdad6" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#ebf5f7" />
    <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#95c4cc" />
    <SolidColorBrush x:Key="ChromeForegroundBrush" Color="#fffafafa" />

</ResourceDictionary>
